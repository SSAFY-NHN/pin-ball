# Unity project location:
# repository-root/pin-ball/

# Codex isolated worktrees
/pin-ball/.worktrees/

# Unity generated directories
/pin-ball/.utmp/
/pin-ball/[Ll]ibrary/
/pin-ball/[Tt]emp/
/pin-ball/[Oo]bj/
/pin-ball/[Bb]uild/
/pin-ball/[Bb]uilds/
/pin-ball/[Ll]ogs/
/pin-ball/[Uu]ser[Ss]ettings/

# Log files
*.log

# Blender backup files
*.blend1
*.blend1.meta

# Memory captures can be large and may contain sensitive data
/pin-ball/[Mm]emoryCaptures/

# Recordings can be large
/pin-ball/[Rr]ecordings/

# Uncomment to ignore the Asset Store Tools plugin
# /pin-ball/[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin
/pin-ball/[Aa]ssets/Plugins/Editor/JetBrains*

# JetBrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
/pin-ball/.vs/

# Gradle cache directory
/pin-ball/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/pin-ball/ExportedObj/
/pin-ball/.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity-generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash-report files
sysinfo.txt

# Mono autogenerated crash files
mono_crash.*

# Build artifacts
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics-generated file
crashlytics-build.properties

# Test Runner-generated files
InitTestScene*.unity*

# Addressables-generated content
/pin-ball/ServerData/
/pin-ball/[Aa]ssets/StreamingAssets/aa*
/pin-ball/[Aa]ssets/AddressableAssetsData/link.xml*
/pin-ball/[Aa]ssets/Addressables_Temp*

# Addressables content state
/pin-ball/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting autogenerated files
/pin-ball/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/pin-ball/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/pin-ball/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/pin-ball/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Autogenerated scenes from play mode tests
/pin-ball/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Autogenerated cache inside Assets
/pin-ball/[Aa]ssets/[Ss]ceneDependencyCache*
